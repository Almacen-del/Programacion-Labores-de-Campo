{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist/web",
  "rewrites":[{"source":"/((?!assets/).*)","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
    {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://dziwhbjyvxdbplthpazt.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"}
  ]},{"source":"/auth/callback","headers":[{"key":"Cache-Control","value":"no-store"}]}]
}
